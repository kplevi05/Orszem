<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (this file overrides the `main` variant for `assembleDebug`).
  Cleartext is permitted so developers can point the app at any local or LAN
  backend. This file is never part of a release/Demo APK.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
