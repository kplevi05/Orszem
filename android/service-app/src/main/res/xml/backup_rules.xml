<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 counterpart of data_extraction_rules.xml. Backup is disabled outright
  by android:allowBackup="false"; this file makes the intent explicit for older devices.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
    <exclude domain="file" />
</full-backup-content>
