# Őrszem Demo v1 — remote deployment configuration reference.
#
# Copy to the repository root as `.env` on the server (git-ignored) and fill in
# freshly generated secrets. NEVER commit a filled-in copy.
#
#   cp infra/compose/.env.example .env && chmod 600 .env
#
# Generate secrets with:
#   openssl rand -base64 36 | tr -d '\n'

# --- Public hostname (must resolve to this VM's public IPv4) ---
ORSZEM_PUBLIC_HOST=129-159-31-175.sslip.io

# --- Spring profile: `demo` enables the demo seed + guarded reset endpoint ---
ORSZEM_PROFILE=demo

# --- API image tag built by scripts/deploy.sh ---
ORSZEM_API_IMAGE=orszem-api:demo

# --- PostgreSQL ---
ORSZEM_DB_NAME=orszem
ORSZEM_DB_USERNAME=orszem
ORSZEM_DB_PASSWORD=CHANGE_ME_generate_a_strong_random_password

# --- JWT signing secret (HS256, >= 32 bytes) ---
ORSZEM_JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret

# --- Demo reset endpoint shared secret (X-Demo-Reset-Token) ---
ORSZEM_DEMO_RESET_TOKEN=CHANGE_ME_generate_a_strong_random_token

# --- JVM sizing for the 1 OCPU / 6 GB VM (override only if you know why) ---
ORSZEM_JAVA_OPTS=-Xms192m -Xmx900m -XX:MaxMetaspaceSize=256m -XX:+UseSerialGC -Duser.timezone=UTC
