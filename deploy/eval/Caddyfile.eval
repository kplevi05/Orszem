# Evaluation edge: the production routing policy (deploy/caddy/Caddyfile) without TLS or real hostnames.
#
# Same policy as production: the Public Web is static and calls the API same-origin at /api/*; actuator,
# the OpenAPI document and Swagger UI are never routed. Differences, all because this is a loopback
# evaluation and not a public site: plain HTTP on one listener (no certificates, no HSTS) and the backend
# reached by its Compose service name.
{
	auto_https off
	admin off
}

:80 {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	encode zstd gzip

	handle /actuator* {
		respond 404
	}
	handle /v3/api-docs* {
		respond 404
	}
	handle /swagger-ui* {
		respond 404
	}
	handle /webjars* {
		respond 404
	}

	handle /api/* {
		reverse_proxy backend:8081 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
			Permissions-Policy "geolocation=(), camera=(), microphone=()"
		}
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
