# Őrszem V2 — public edge.
#
# Three hosts, one backend:
#
#   www.orszembejelento.hu  -> permanent redirect to the apex
#   orszembejelento.hu      -> static Public Web, with /api/* proxied to the backend
#   api.orszembejelento.hu  -> the same backend, for the Android clients
#
# Both routes reach the SAME backend and the same use cases. The API is never
# implemented twice.
#
# Requirements before this file can obtain certificates:
#   - A records for all three names must resolve to this machine's public IPv4
#     (see docs/deployment/DNS.md). ACME HTTP-01 fails otherwise.
#   - The backend must be listening on 127.0.0.1:8081 (see deploy/systemd/).
#
# The backend binds to loopback only and is never reachable from the internet
# except through this proxy. PostgreSQL is never proxied and never published.
{
	# Admin API on loopback only.
	admin 127.0.0.1:2019

	# Advertise HTTP/3 only if UDP/443 is actually open in both firewalld and the
	# OCI security list. It is not, so restrict to HTTP/1.1 and HTTP/2.
	servers {
		protocols h1 h2
	}
}

# Shared response headers. Snippets keep the three sites from drifting apart.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

(block_internal_paths) {
	# Spring Boot management, OpenAPI and Swagger UI must never be publicly routed.
	# These handle blocks are imported FIRST in every site, and handle blocks are
	# mutually exclusive and evaluated in source order, so they win over any later
	# proxy or file_server block. Verified by scripts/verify-caddy-routing.sh.
	handle /actuator* {
		respond 404
	}
	handle /v3/api-docs* {
		respond 404
	}
	handle /swagger-ui* {
		respond 404
	}
	handle /swagger-ui.html {
		respond 404
	}
	handle /webjars* {
		respond 404
	}
}

(backend_proxy) {
	reverse_proxy 127.0.0.1:8081 {
		# Overwrite rather than append, so the backend receives exactly one value that
		# Caddy determined from the real TCP peer. Caddy would otherwise append to any
		# X-Forwarded-For the client sent, leaving attacker-controlled entries in the
		# header. The backend is defensive about this anyway (it reads the rightmost
		# entry and only from a trusted peer), but there is no reason to forward a
		# forged value at all.
		header_up X-Forwarded-For {remote_host}
	}
}

# Caddy's structured access log includes every request header by default - confirmed by
# running this config against a real request, not assumed. X-Orszem-Report-Access carries a
# Public report's bare access capability (ADR 0008), a live credential, not diagnostic data:
# logging it would put it in a file with a completely different retention, access and
# rotation policy than the database it is meant to protect. It is a custom header, so
# nothing else protects it - this rule is the only thing that does.
#
# Authorization is listed here too, as explicit, verified defence-in-depth: Caddy 2.11.4
# already redacts that one unconditionally as a built-in default (its value comes back as
# the literal string "REDACTED" in the log even with this rule removed - confirmed by
# testing, not assumed), so this line pins that behaviour explicitly rather than relying on
# an undocumented default that a future Caddy version could change.
#
# This deletes both headers from the LOG ENTRY only, via Caddy's supported log field filter
# (the "filter" log encoder wrapping the normal one). It does not touch the proxied request:
# reverse_proxy above still forwards the real header values to the backend untouched. Proven
# by scripts/verify-caddy-header-redaction.sh, including a negative control for
# X-Orszem-Report-Access (the header actually at risk) that fails if its rule is removed or
# its field path is wrong.
(access_log) {
	log {
		output file {args[0]}
		format filter {
			wrap console
			fields {
				request>headers>X-Orszem-Report-Access delete
				request>headers>Authorization delete
			}
		}
	}
}

www.orszembejelento.hu {
	import security_headers
	redir https://orszembejelento.hu{uri} permanent
}

orszembejelento.hu {
	import security_headers
	encode zstd gzip

	import block_internal_paths

	# Same-origin API. This is why the browser needs no CORS header at all.
	handle /api/* {
		import backend_proxy
	}

	# Static Public Web build output (web/public-web/dist), deployed by the runbook.
	handle {
		root * /home/opc/apps/orszem-v2/web
		try_files {path} /index.html
		file_server
	}

	import access_log /var/log/caddy/orszembejelento.log
}

api.orszembejelento.hu {
	import security_headers
	encode zstd gzip

	import block_internal_paths

	handle /api/* {
		import backend_proxy
	}

	# Nothing else is served on the API host. Actuator, the OpenAPI document and
	# Swagger UI stay on loopback and are not exposed publicly.
	handle {
		respond 404
	}

	import access_log /var/log/caddy/api-orszembejelento.log
}
