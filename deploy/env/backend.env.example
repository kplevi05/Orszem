# Őrszem V2 backend environment — TEMPLATE.
#
# Copy to /etc/orszem/backend.env on the server, fill in real values, then:
#   sudo chown root:orszem /etc/orszem/backend.env
#   sudo chmod 640 /etc/orszem/backend.env
#
# NEVER commit the filled-in file. Every value below is a placeholder.
# Generate the password with a password manager or `openssl rand -base64 32`;
# do not reuse any Demo v1 credential.

# --- Database -----------------------------------------------------------------
# A clean V2 database and role. No V1 data is migrated, and V1's tables are not reused.
ORSZEM_DB_URL=jdbc:postgresql://127.0.0.1:5432/orszem_v2
ORSZEM_DB_USERNAME=orszem_v2
ORSZEM_DB_PASSWORD=CHANGE_ME_generate_a_strong_random_password

# --- HTTP ---------------------------------------------------------------------
# Loopback only. Caddy is the sole public edge; the backend is never exposed directly.
ORSZEM_BIND_ADDRESS=127.0.0.1
# Distinct from any still-running Demo v1 backend on 8080.
ORSZEM_PORT=8081

# --- JVM ----------------------------------------------------------------------
JAVA_TOOL_OPTIONS=-Duser.timezone=UTC

# --- Authentication (Phase 2) -------------------------------------------------
# All optional; the defaults below are the built-in ones and are shown for reference.
# There are no secrets here: tokens are generated per session, and there is no
# signing key to configure because the design uses opaque tokens, not JWT.
#ORSZEM_ACCESS_TOKEN_LIFETIME=15m
#ORSZEM_SESSION_LIFETIME=30d

# Brute-force throttling. Provisional pilot values, expected to be tuned against real
# traffic. Counters are in-memory and reset on restart - acceptable for one instance.
#ORSZEM_RATE_LIMIT_ENABLED=true
#ORSZEM_RATE_LIMIT_SERVICE_ID_ATTEMPTS=10
#ORSZEM_RATE_LIMIT_IP_ATTEMPTS=40
#ORSZEM_RATE_LIMIT_WINDOW=15m
#ORSZEM_RATE_LIMIT_RETRY_AFTER=1m
