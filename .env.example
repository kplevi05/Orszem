# Őrszem Demo v1 — configuration reference.
# Copy to .env (git-ignored) for local use. Never commit real secrets.

# --- Backend datasource ---
ORSZEM_DB_URL=jdbc:postgresql://localhost:5432/orszem
ORSZEM_DB_USERNAME=orszem
ORSZEM_DB_PASSWORD=orszem

# --- Backend HTTP ---
ORSZEM_PORT=8080
# local | demo   (never "production" for the demo build)
SPRING_PROFILES_ACTIVE=local

# --- JWT signing secret (HS256, >= 32 bytes) ---
# Required in the demo profile and any shared environment.
# The local profile has a built-in development-only fallback.
ORSZEM_JWT_SECRET=

# --- Demo reset script ---
# Used by scripts/reset-demo.sh
DATABASE_URL=postgresql://orszem:orszem@localhost:5432/orszem

# --- Android client ---
# Base URL the apps use to reach the API (see apps/android/gradle/libs.versions.toml
# and each app's build config).
ORSZEM_API_BASE_URL=http://10.0.2.2:8080/
